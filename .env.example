# Get free API keys from:
# Alpha Vantage: https://www.alphavantage.co/support/#api-key
# FRED: https://fred.stlouisfed.org/docs/api/api_key.html
# Polygon: https://polygon.io/dashboard/signup
# Finnhub: https://finnhub.io/register (60 calls/min free)
# NewsAPI: https://newsapi.org/register (100 requests/day free - adds Reuters, Bloomberg headlines)

ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FRED_API_KEY=your_fred_api_key
POLYGON_API_KEY=your_polygon_api_key
FINNHUB_API_KEY=your_finnhub_api_key
NEWS_API_KEY=your_newsapi_key
PORT=5000

# =============================================================================
# NEWS ANALYSIS (Google Sheets + Claude AI) - NEW in v2.1
# =============================================================================

# Anthropic API Key for Claude AI news analysis
# Get yours at: https://console.anthropic.com/
# This enables AI-powered analysis of news headlines for trading insights
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -----------------------------------------------------------------------------
# COST CONTROL (added to cut Anthropic spend on the dev dashboard)
# -----------------------------------------------------------------------------
# Which Claude model the AI summaries/briefs use. Defaults to Haiku 4.5 (cheap:
# ~$1/$5 per M tokens). Set to claude-sonnet-4-20250514 to restore Sonnet 4
# (higher quality, ~3x the cost) globally.
AI_MODEL=claude-haiku-4-5-20251001
#
# Background pre-warm calls Claude every ~4 min, 24/7, even with no users — the
# main idle cost. OFF by default. Set to true ONLY if you want the dashboard
# kept perpetually hot (e.g. in production with real traffic).
ENABLE_PREWARM=false

# Google Sheets Published CSV URL
# Steps to get this URL:
# 1. Open your Google Sheet with news headlines
# 2. Go to File → Share → Publish to web
# 3. Select the sheet tab containing your headlines
# 4. Choose "Comma-separated values (.csv)" format
# 5. Click "Publish" and copy the generated URL
# Expected columns: headline, source, url, timestamp (flexible naming)
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/pub?output=csv
